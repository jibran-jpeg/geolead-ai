{
  "manifest_version": 3,
  "name": "GeoLead AI",
  "version": "3.0.0",
  "description": "Production-grade Google Maps scraper with advanced lead generation, scoring, and analysis capabilities",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://*.google.com/*",
    "https://*.maps.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeoLead AI - Lead Extractor",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_badge": "default"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "src/*",
        "*.js",
        "*.css",
        "*.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.google.com/maps/*", "https://*.maps.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "minimum_chrome_version": "88",
  "author": "GeoLead AI Team",
  "homepage_url": "https://github.com/your-username/geolead-ai",
  "support_url": "https://github.com/your-username/geolead-ai/issues"
}